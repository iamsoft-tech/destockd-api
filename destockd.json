    {
      "name": "getFilm",
      "description": "Every shot in a film, in order. For a shot's archive.org / National Archives source links, call getShot.",
      "request": {
        "method": "GET",
        "url": "https://www.destockd.com/api/film/%7Bfilm%7D",
        "headers": {
          "accept": "*/*",
          "accept-language": "en-US,en;q=0.9",
          "priority": "u=1, i",
          "referer": "https://www.destockd.com/",
          "sec-ch-ua": "\"Google Chrome\";v=\"155\", \"Chromium\";v=\"155\", \"Not(A:Brand\";v=\"24\"",
          "sec-ch-ua-mobile": "?0",
          "sec-ch-ua-platform": "\"Windows\"",
          "sec-fetch-dest": "empty",
          "sec-fetch-mode": "cors",
          "sec-fetch-site": "same-origin",
          "user-agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/155.0.0.0 Safari/537.36"
        }
      },
      "slots": [
        {
          "param": "film",
          "at": [
            "path:2"
          ]
        }
      ],
      "volatile": [],
      "trigger": {
        "url": "https://www.destockd.com/#/film/Homecoming"
      },
      "match": {
        "method": "GET",
        "host": "www.destockd.com",
        "path": "/api/film/*"
      },
      "response": {
        "format": "json",
        "contentType": "application/json",
        "extract": "shots"
      },
      "params": [
        {
          "name": "film",
          "type": "string",
          "required": true
        }
      ],
      "readOnly": true,
      "minTier": 1,
      "learnedLoggedIn": false
    }
  ]
}
